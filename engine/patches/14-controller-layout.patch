+
+    // gow-native-pc: controller layout chosen in the launcher. TOBIICHI_MANDO="accion=boton,boton;..." with the same action
+    // names as TOBIICHI_TECLAS (buttons only: up .. furia) and raylib gamepad buttons (GAMEPAD_BUTTON_*: 1-4 d-pad,
+    // 5-8 face buttons, 9-12 LB LT RB RT, 13 back, 15 start, 16/17 stick clicks). Without it the fixed layouts below
+    // (TOBIICHI_DMC5_CONTROLS) stay. The sticks are not mapped.
+    struct MapaMando
+    {
+        bool activo = false;
+        std::array<std::vector<int>, AccFuria + 1> botones;
+    };
+
+    const MapaMando &mapaMando()
+    {
+        static const MapaMando mapa = []
+        {
+            MapaMando m;
+            const char *valor = std::getenv("TOBIICHI_MANDO");
+            if (!valor || !*valor)
+                return m;
+            m.activo = true;
+            const std::string texto(valor);
+            size_t pos = 0;
+            while (pos < texto.size())
+            {
+                size_t fin = texto.find(';', pos);
+                if (fin == std::string::npos)
+                    fin = texto.size();
+                const std::string par = texto.substr(pos, fin - pos);
+                const size_t igual = par.find('=');
+                if (igual != std::string::npos)
+                {
+                    const std::string nombre = par.substr(0, igual);
+                    for (size_t a = 0; a <= AccFuria; ++a)
+                    {
+                        if (nombre != kNombresAccion[a])
+                            continue;
+                        size_t p = igual + 1;
+                        while (p < par.size())
+                        {
+                            size_t coma = par.find(',', p);
+                            if (coma == std::string::npos)
+                                coma = par.size();
+                            const int boton = std::atoi(par.substr(p, coma - p).c_str());
+                            if (boton >= GAMEPAD_BUTTON_LEFT_FACE_UP && boton <= GAMEPAD_BUTTON_RIGHT_THUMB)
+                                m.botones[a].push_back(boton);
+                            p = coma + 1;
+                        }
+                    }
+                }
+                pos = fin + 1;
+            }
+            return m;
+        }();
+        return mapa;
+    }
 }
 
