+// gow-native-pc: the continuous capture on the native path. compiledProgramFor did it on every micro-memory change
+// (~650 a second in combat): a full decode of the 2,048 pairs (the exact engine redecodes lazily anyway), a byte-wise
+// 16 KB FNV hash and a file-system query, ~15 % of the VU1 worker. Here a word-wise 64-bit hash is looked up among the
+// images already seen (the capture folder is listed once); only a new image gets its FNV file name and is written, so
+// the files are the same as before.
+void captureMicrocode(const uint8_t *vuCode, uint32_t codeSize, const PS2Memory *memory)
+{
+    static const char *captureDir = std::getenv("GOW_VU1_CAPTURA");
+    if (captureDir == nullptr || memory == nullptr || codeSize != PS2_VU1_CODE_SIZE || (codeSize & 7u) != 0u)
+        return;
+    static uint64_t lastGeneration = ~0ull;
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    if (generation == lastGeneration)
+        return;
+    lastGeneration = generation;
+    uint64_t quick = 0x9E3779B97F4A7C15ull ^ codeSize;
+    for (uint32_t i = 0; i < codeSize; i += 8u)
+    {
+        uint64_t word;
+        std::memcpy(&word, vuCode + i, sizeof(word));
+        quick = (quick ^ (word * 0xBF58476D1CE4E5B9ull)) * 0x94D049BB133111EBull;
+        quick ^= quick >> 31;
+    }
+    static std::unordered_set<uint64_t> seenQuick;
+    if (!seenQuick.insert(quick).second)
+        return;
+    static const std::unordered_set<std::string> savedNames = []
+    {
+        std::unordered_set<std::string> names;
+        std::error_code error;
+        for (const auto &entry : std::filesystem::directory_iterator(captureDir, error))
+            names.insert(entry.path().filename().string());
+        return names;
+    }();
+    char name[64];
+    std::snprintf(name, sizeof(name), "vu1_%016llx.bin",
+                  static_cast<unsigned long long>(VU1Interpreter::hashMicrocode(vuCode, codeSize)));
+    if (savedNames.contains(name))
+        return;
+    if (std::FILE *file = std::fopen((std::string(captureDir) + "/" + name).c_str(), "wb"))
+    {
+        std::fwrite(vuCode, 1, codeSize, file);
+        std::fclose(file);
+    }
+}
