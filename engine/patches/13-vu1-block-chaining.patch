+// gow-native-pc: block chaining, see the declaration. The exit half is runNative's code after a block, the entry half its
+// code before one; the entry half changes nothing until every condition runNative would handle itself has passed.
+VU1Interpreter::NativeState::Slot *VU1NativeAccess::chain(VU1NativeCtx &n, uint32_t next)
+{
+    using NS = VU1Interpreter::NativeState;
+    VU1Interpreter &vu = *n.vu;
+    NS &ns = *vu.m_native;
+    const NS::Slot &cur = *static_cast<const NS::Slot *>(n.slot);
+    finishBlockTiming(vu, cur, n.cyc, n.cycId, n.start);
+    if (vu.m_cycle >= vu.m_nextCommitCycle)
+        commitDue(vu);
+    n.pairs += cur.pairs;
+    ++n.blocks;
+    if (ns.diag && (next & 0x3FF8u) == n.pc)
+        ++ns.selfBlocks, ns.selfPairs += cur.pairs;
+    vu.m_state.pc = next & 0x3FFFu;
+    // with a guaranteed tail call (clang, VU1N_MUSTTAIL) the chain uses no stack; otherwise (MSVC with GOW_VU1N_CHAIN=1)
+    // each chained block keeps its frame and runNative takes over every 64 blocks
+#if defined(__clang__)
+    constexpr uint32_t kMaxDepth = 4096u;
+#else
+    constexpr uint32_t kMaxDepth = 64u;
+#endif
+    if (!n.chain || n.depth >= kMaxDepth)
+        return nullptr;
+    const auto &context = *static_cast<const VU1Interpreter::StepContext *>(n.context);
+    if (vu.m_stopRequested || vu.m_cycle >= context.budgetEnd)
+        return nullptr;
+    const uint32_t pc = next & 0x3FF8u;
+    if (pc + 8u > context.codeSize)
+        return nullptr;
+    NS::Slot &sl = ns.slots[pc >> 3];
+    if (!sl.known || !sl.fn)
+        return nullptr;
+    if (((sl.laneReq[0] & ~n.known0) | (sl.laneReq[1] & ~n.known1)) != 0u)
+        return nullptr; // an entry lane check: runNative does it (and counts it)
+    n.known0 = (n.known0 & sl.laneKeep[0]) | sl.laneGen[0] | 0xFu;
+    n.known1 = (n.known1 & sl.laneKeep[1]) | sl.laneGen[1];
+    const uint64_t start = vu.m_cycle;
+    uint32_t cycId = 0u;
+    const uint8_t *cyc = sl.readsEntryFlags ? blockTiming(vu, sl, cycId) : sl.idle;
+    n.cyc = cyc;
+    n.start = start;
+    if (sl.tail)
+    {
+        VU1FlagTail &t = ns.hist[ns.histNext].tail;
+        t.desc = sl.tail;
+        t.cyc = cyc;
+        t.start = start;
+        n.tail = &t;
+    }
+    n.slot = &sl;
+    n.pc = pc;
+    n.cycId = cycId;
+    ++n.depth;
+    return &sl;
+}
