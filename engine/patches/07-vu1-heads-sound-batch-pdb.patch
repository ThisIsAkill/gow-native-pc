+// gow-native-pc: with the VU1 capture on (GOW_VU1_CAPTURA), a block entry the native code does not have (an entry point the
+// generator cannot see, such as a jump through a register) is appended to <capture>/vu1n_heads_seen.txt; the pipeline merges
+// those into vu1n_heads.txt, so the next "native" build generates the block. Only on slot setup, once per pc.
+void VU1NativeAccess::recordMissHead(uint32_t pc)
+{
+    static const char *dir = std::getenv("GOW_VU1_CAPTURA");
+    if (!dir || !*dir)
+        return;
+    static std::mutex mutex;
+    static std::unordered_set<uint32_t> seen;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!seen.insert(pc).second)
+        return;
+    const std::string path = std::string(dir) + "/vu1n_heads_seen.txt";
+    if (FILE *f = std::fopen(path.c_str(), "a"))
+    {
+        std::fprintf(f, "%x\n", pc);
+        std::fclose(f);
+    }
+}
